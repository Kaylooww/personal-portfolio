# Copy to .env.local on first setup. Never commit real credentials.
# See DEVELOPMENT.md and DEPLOYMENT.md for the full environment reference.

# Canonical origin: use the final HTTPS domain in Production, then rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required public connection values. A publishable key (sb_publishable_...)
# goes in ANON_KEY; a legacy anon key also works. RLS applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only maintenance key (sb_secret_... or legacy service_role).
# Normal app/admin operations use the publishable key plus session and RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Confirmed Auth user's email; must also be in private.admin_users.
ADMIN_EMAIL=

# Keep this name: migrations and shared MEDIA_BUCKET use portfolio-media.
# Changing this variable alone does not rename the upload bucket.
SUPABASE_STORAGE_BUCKET=portfolio-media
