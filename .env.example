# Kyle Angelo C. Castro — Portfolio
# Copy to .env.local and fill in real values.
# NEVER commit .env.local.
# ─────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 9) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Email of the single administrator account (Phase 10)
ADMIN_EMAIL=

# Supabase Storage bucket name (Phase 9)
SUPABASE_STORAGE_BUCKET=portfolio-media
